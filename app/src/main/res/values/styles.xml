<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cartão branco com borda fina e cantos de 16dp -->
    <style name="TrilhaApp.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">@dimen/raio_cartao</item>
        <item name="strokeColor">@color/borda</item>
        <item name="strokeWidth">@dimen/borda_cartao</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Cartão do menu da tela principal (clicável, com ripple) -->
    <style name="TrilhaApp.Cartao.Menu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espaco_medio</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Raiz dos estilos internos dos cartões do menu -->
    <style name="TrilhaApp.Menu" parent="" />

    <style name="TrilhaApp.Menu.Conteudo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/alvo_toque_minimo</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/menu_padding</item>
    </style>

    <!-- Quadrado verde-claro atrás do ícone do menu -->
    <style name="TrilhaApp.Menu.Icone">
        <item name="android:layout_width">@dimen/menu_icone_container</item>
        <item name="android:layout_height">@dimen/menu_icone_container</item>
        <item name="android:background">@drawable/bg_icone_menu</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/verde_primario</item>
    </style>

    <style name="TrilhaApp.Menu.Textos">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/espaco_grande</item>
        <item name="android:layout_marginEnd">@dimen/espaco_pequeno</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TrilhaApp.Menu.Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto_titulo_cartao</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TrilhaApp.Menu.Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">@dimen/texto_subtitulo_cartao</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="TrilhaApp.Menu.Seta">
        <item name="android:layout_width">@dimen/seta</item>
        <item name="android:layout_height">@dimen/seta</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/texto_secundario</item>
    </style>

    <!-- Chip informativo (não clicável) da configuração atual -->
    <style name="TrilhaApp.ChipInfo" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:checkable">false</item>
        <item name="android:textSize">@dimen/texto_chip</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="chipBackgroundColor">@color/superficie</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/raio_cartao</item>
    </style>
</resources>

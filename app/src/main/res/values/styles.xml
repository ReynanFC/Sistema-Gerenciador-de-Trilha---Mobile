<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- White card with thin outline and 16dp corners -->
    <style name="TrilhaApp.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Main screen menu card (clickable, with ripple) -->
    <style name="TrilhaApp.Card.Menu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/spacing_medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Parent of the menu card inner styles -->
    <style name="TrilhaApp.Menu" parent="" />

    <style name="TrilhaApp.Menu.Content">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/menu_padding</item>
    </style>

    <!-- Light green square behind the menu icon -->
    <style name="TrilhaApp.Menu.Icon">
        <item name="android:layout_width">@dimen/menu_icon_container</item>
        <item name="android:layout_height">@dimen/menu_icon_container</item>
        <item name="android:background">@drawable/bg_menu_icon</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/green_primary</item>
    </style>

    <style name="TrilhaApp.Menu.Texts">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_large</item>
        <item name="android:layout_marginEnd">@dimen/spacing_small</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TrilhaApp.Menu.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TrilhaApp.Menu.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">@dimen/text_card_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TrilhaApp.Menu.Chevron">
        <item name="android:layout_width">@dimen/chevron_size</item>
        <item name="android:layout_height">@dimen/chevron_size</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_secondary</item>
    </style>

    <!-- Read-only chip showing the current settings -->
    <style name="TrilhaApp.ChipInfo" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:checkable">false</item>
        <item name="android:textSize">@dimen/text_chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/card_corner_radius</item>
    </style>

    <!-- Section label in uppercase (e.g. "TIPO DE MAPA") -->
    <style name="TrilhaApp.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_section_label</item>
    </style>

    <!-- Selectable option card: outline and background change when checked -->
    <style name="TrilhaApp.Card.Option">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_small</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:checkable">true</item>
        <item name="checkedIcon">@null</item>
        <item name="strokeColor">@color/selector_option_stroke</item>
        <item name="strokeWidth">@dimen/option_selected_stroke_width</item>
        <item name="cardBackgroundColor">@color/selector_option_background</item>
    </style>

    <!-- Small green "Padrão" badge -->
    <style name="TrilhaApp.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">@dimen/spacing_small</item>
        <item name="android:paddingEnd">@dimen/spacing_small</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:textSize">@dimen/text_badge</item>
    </style>

    <!-- Full-width green primary button -->
    <style name="TrilhaApp.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
    </style>

    <!-- Record trail screen: controls floating over the map -->
    <style name="TrilhaApp.MapRoundButton" parent="">
        <item name="android:layout_width">@dimen/map_control_size</item>
        <item name="android:layout_height">@dimen/map_control_size</item>
        <item name="android:background">@drawable/bg_map_round_button</item>
        <item name="android:elevation">@dimen/map_control_elevation</item>
        <item name="android:padding">@dimen/map_control_icon_padding</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Card floating over the map: shadow instead of outline -->
    <style name="TrilhaApp.Card.Floating">
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">@dimen/map_control_elevation</item>
    </style>

    <style name="TrilhaApp.Stat" parent="" />

    <style name="TrilhaApp.Stat.Column">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TrilhaApp.Stat.Values">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TrilhaApp.Stat.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:text">@string/record_value_zero</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_stat_value</item>
    </style>

    <style name="TrilhaApp.Stat.Unit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_stat_unit</item>
    </style>

    <!-- Pause (white) and Finish (red) buttons side by side -->
    <style name="TrilhaApp.Button.Map" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">@dimen/map_control_elevation</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="TrilhaApp.Button.Map.Pause">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="rippleColor">@color/outline</item>
    </style>

    <style name="TrilhaApp.Button.Map.Finish">
        <item name="backgroundTint">@color/red_destructive</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="iconTint">@color/text_on_primary</item>
    </style>

    <!-- Label + value tile (finish sheet grid, detail panel) -->
    <style name="TrilhaApp.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_stat_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/tile_padding</item>
    </style>

    <style name="TrilhaApp.Tile.Label" parent="TrilhaApp.SectionLabel">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TrilhaApp.Tile.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_tile_value</item>
    </style>

    <!-- Outlined text field with the app corner radius and green focus -->
    <style name="TrilhaApp.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">@dimen/icon_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/icon_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/icon_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/icon_corner_radius</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>

    <!-- White outlined secondary button (Descartar) -->
    <style name="TrilhaApp.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Small green value pill on the trail cards (distance, duration) -->
    <style name="TrilhaApp.MetricPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_metric</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">@dimen/spacing_small</item>
        <item name="android:paddingEnd">@dimen/spacing_small</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:textSize">@dimen/text_metric</item>
    </style>

    <!-- 48dp icon button used on the cards (edit / delete) -->
    <style name="TrilhaApp.IconButton" parent="">
        <item name="android:layout_width">@dimen/min_touch_target</item>
        <item name="android:layout_height">@dimen/min_touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>

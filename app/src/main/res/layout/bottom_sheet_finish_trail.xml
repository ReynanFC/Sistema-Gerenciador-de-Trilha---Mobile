<?xml version="1.0" encoding="utf-8"?>
<!-- Finish trail sheet: name field + 2x3 summary grid + Discard / Save.
     Shown by RecordTrailActivity in a BottomSheetDialog. Prototype: docs/prototipo/04-salvar-trilha.png -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/screen_margin">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:fontFamily="sans-serif-medium"
        android:text="@string/finish_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_sheet_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/finish_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_card_subtitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:fontFamily="sans-serif-medium"
        android:labelFor="@id/edit_trail_name"
        android:text="@string/finish_name_label"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_card_subtitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_trail_name"
        style="@style/TrilhaApp.TextField"
        android:layout_marginTop="@dimen/spacing_small"
        android:hint="@string/finish_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_trail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Summary grid: 3 rows x 2 tiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:orientation="horizontal">

        <LinearLayout style="@style/TrilhaApp.Tile">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/finish_start" />

            <TextView
                android:id="@+id/text_finish_start"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="24/11/2026 · 07:12" />
        </LinearLayout>

        <LinearLayout
            style="@style/TrilhaApp.Tile"
            android:layout_marginStart="@dimen/spacing_small">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/finish_end" />

            <TextView
                android:id="@+id/text_finish_end"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="24/11/2026 · 07:54" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:orientation="horizontal">

        <LinearLayout style="@style/TrilhaApp.Tile">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/finish_duration" />

            <TextView
                android:id="@+id/text_finish_duration"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="00:42:17" />
        </LinearLayout>

        <LinearLayout
            style="@style/TrilhaApp.Tile"
            android:layout_marginStart="@dimen/spacing_small">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/record_distance" />

            <TextView
                android:id="@+id/text_finish_distance"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="3,48 km" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:orientation="horizontal">

        <LinearLayout style="@style/TrilhaApp.Tile">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/finish_average_speed" />

            <TextView
                android:id="@+id/text_finish_average_speed"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="4,9 km/h" />
        </LinearLayout>

        <LinearLayout
            style="@style/TrilhaApp.Tile"
            android:layout_marginStart="@dimen/spacing_small">

            <TextView
                style="@style/TrilhaApp.Tile.Label"
                android:text="@string/finish_max_speed" />

            <TextView
                android:id="@+id/text_finish_max_speed"
                style="@style/TrilhaApp.Tile.Value"
                tools:text="8,9 km/h" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_discard"
            style="@style/TrilhaApp.Button.Secondary"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="@string/finish_discard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_trail"
            style="@style/TrilhaApp.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/finish_save" />
    </LinearLayout>
</LinearLayout>

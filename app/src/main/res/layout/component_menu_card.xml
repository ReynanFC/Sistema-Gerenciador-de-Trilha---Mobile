<?xml version="1.0" encoding="utf-8"?>
<!-- Componente: cartão de opção do menu (ícone, título, subtítulo e seta).
     Usado via <include android:id="@+id/..." layout="@layout/component_menu_card" />.
     O id do include substitui o id da raiz; ícone e textos são preenchidos pela Activity
     através de menu_card_icone, menu_card_titulo e menu_card_subtitulo. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TrilhaApp.Cartao.Menu">

    <LinearLayout style="@style/TrilhaApp.Menu.Conteudo">

        <ImageView
            android:id="@+id/menu_card_icone"
            style="@style/TrilhaApp.Menu.Icone"
            tools:src="@drawable/ic_registrar" />

        <LinearLayout style="@style/TrilhaApp.Menu.Textos">

            <TextView
                android:id="@+id/menu_card_titulo"
                style="@style/TrilhaApp.Menu.Titulo"
                tools:text="@string/menu_registrar_titulo" />

            <TextView
                android:id="@+id/menu_card_subtitulo"
                style="@style/TrilhaApp.Menu.Subtitulo"
                tools:text="@string/menu_registrar_subtitulo" />
        </LinearLayout>

        <ImageView style="@style/TrilhaApp.Menu.Seta" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

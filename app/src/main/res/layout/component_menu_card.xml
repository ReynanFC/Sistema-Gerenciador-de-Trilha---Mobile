<?xml version="1.0" encoding="utf-8"?>
<!-- Component: menu option card (icon, title, subtitle and chevron).
     Used via <include android:id="@+id/..." layout="@layout/component_menu_card" />.
     The include id replaces the root id; the icon and texts are filled in by the Activity
     through menu_card_icon, menu_card_title and menu_card_subtitle. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TrilhaApp.Card.Menu">

    <LinearLayout style="@style/TrilhaApp.Menu.Content">

        <ImageView
            android:id="@+id/menu_card_icon"
            style="@style/TrilhaApp.Menu.Icon"
            tools:src="@drawable/ic_record" />

        <LinearLayout style="@style/TrilhaApp.Menu.Texts">

            <TextView
                android:id="@+id/menu_card_title"
                style="@style/TrilhaApp.Menu.Title"
                tools:text="@string/menu_record_title" />

            <TextView
                android:id="@+id/menu_card_subtitle"
                style="@style/TrilhaApp.Menu.Subtitle"
                tools:text="@string/menu_record_subtitle" />
        </LinearLayout>

        <ImageView style="@style/TrilhaApp.Menu.Chevron" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

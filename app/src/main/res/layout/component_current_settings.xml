<?xml version="1.0" encoding="utf-8"?>
<!-- Component: "Current settings" card with map type and navigation chips.
     The chip texts are filled in by the Activity (onResume) from the saved preferences. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/current_settings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_current_settings"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingEnd="16dp"
    android:paddingBottom="@dimen/spacing_small">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:text="@string/main_current_settings"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_section_label" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="@dimen/spacing_small">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_map_type"
            style="@style/TrilhaApp.ChipInfo"
            android:text="@string/settings_map_vector" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_navigation"
            style="@style/TrilhaApp.ChipInfo"
            android:text="@string/settings_north_up" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>

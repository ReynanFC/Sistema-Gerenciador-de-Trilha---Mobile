<?xml version="1.0" encoding="utf-8"?>
<!-- Componente: cabeçalho verde da tela principal (ícone, nome do app e subtítulo).
     Usado via <include layout="@layout/component_header_principal" />. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cabecalho"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/verde_primario"
    android:orientation="vertical"
    android:paddingStart="@dimen/espaco_grande"
    android:paddingTop="@dimen/espaco_grande"
    android:paddingEnd="@dimen/espaco_grande"
    android:paddingBottom="28dp">

    <ImageView
        android:layout_width="@dimen/cabecalho_icone_container"
        android:layout_height="@dimen/cabecalho_icone_container"
        android:background="@drawable/bg_icone_cabecalho"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_montanha"
        app:tint="@color/texto_sobre_primario" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_grande"
        android:fontFamily="sans-serif-black"
        android:text="@string/app_name"
        android:textColor="@color/texto_sobre_primario"
        android:textSize="@dimen/texto_titulo_app" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:text="@string/principal_subtitulo"
        android:textColor="@color/texto_sobre_primario_secundario"
        android:textSize="@dimen/texto_subtitulo_app" />
</LinearLayout>
